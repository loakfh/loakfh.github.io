---
// Корень сайта: GitHub Pages не умеет выбирать язык на сервере, поэтому редирект
// делает скрипт: сохранённый выбор → язык браузера → язык по умолчанию.
import { LANGS, shared, siteUrl } from '../lib/i18n';
const fallback = shared.site.defaultLang;
const codes = LANGS.map((l) => l.code);
---
<!doctype html>
<html lang={fallback}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{shared.person.nameLatin}</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={siteUrl(`/${fallback}/`)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline define:vars={{ codes, fallback }}>
      var pick = null;
      try { pick = localStorage.getItem('lang'); } catch (e) {}
      if (codes.indexOf(pick) < 0) {
        pick = null;
        var prefs = navigator.languages || [navigator.language || ''];
        for (var i = 0; i < prefs.length && !pick; i++) {
          var short = String(prefs[i]).toLowerCase().split('-')[0];
          if (codes.indexOf(short) >= 0) pick = short;
        }
      }
      location.replace('/' + (pick || fallback) + '/' + location.search + location.hash);
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=/${fallback}/`} /></noscript>
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-content: center; gap: 12px; background: #0E0F0C; color: #EDEAE0; font: 18px/1.4 system-ui, sans-serif; text-align: center; }
      a { color: #FF5A36; padding: 8px; }
    </style>
  </head>
  <body>
    {LANGS.map((l) => <a href={`/${l.code}/`} lang={l.code} hreflang={l.code}>{l.name}</a>)}
  </body>
</html>
