---
import '@fontsource-variable/golos-text/index.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import { LANGS, shared, siteUrl } from '../lib/i18n';

interface Props {
  lang: string;
  locale: string;
  title: string;
  description: string;
  path: string;
  ogImage: string;
  ogAlt: string;
}
const { lang, locale, title, description, path, ogImage, ogAlt } = Astro.props;
const canonical = siteUrl(path);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {shared.site.noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l.code} href={siteUrl(`/${l.code}/`)} />)}
    <link rel="alternate" hreflang="x-default" href={siteUrl(`/${shared.site.defaultLang}/`)} />
    <meta name="theme-color" content="#0E0F0C" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={shared.person.nameLatin} />
    <meta property="og:locale" content={locale} />
    {LANGS.filter((l) => l.code !== lang).map((l) => <meta property="og:locale:alternate" content={l.locale} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={siteUrl(ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={siteUrl(ogImage)} />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!calm && !sessionStorage.getItem('intro')) d.classList.add('intro-on');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
